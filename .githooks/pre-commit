#!/usr/bin/env bash
set -e

echo "========================================================"
echo "🔍 [Pre-Commit Hook] Running Detekt lint checks..."
echo "========================================================"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [ -f "$REPO_ROOT/gradlew" ]; then
    GRADLE_BIN="$REPO_ROOT/gradlew"
else
    GRADLE_BIN="gradle"
fi

"$GRADLE_BIN" detekt --no-daemon

echo "========================================================"
echo "✅ [Pre-Commit Hook] All lint checks passed!"
echo "========================================================"
